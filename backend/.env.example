# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase — create a project at https://supabase.com and copy these from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT — generate a strong secret: `openssl rand -hex 64`
# NEVER use the default value in production
JWT_SECRET=replace-with-a-long-random-string-generated-by-openssl-rand-hex-64
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Stellar Testnet — create a funded testnet keypair at https://laboratory.stellar.org/#account-creator
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=
STELLAR_ISSUER_ACCOUNT_ID=

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# CORS — space-separated origins for local dev; override in production
CORS_ORIGIN=http://localhost:3000
